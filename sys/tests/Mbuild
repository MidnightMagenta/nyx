local mbl = require("mbuildlib")
local sdirt = require("sdirtable")

local c_srcs = mbl.files({
	"main.c",
	"physmem.c",
	"sanity.c",
	"slab.c",
})

local subdir_into = sdirt.new()
subdir_into:add(
	mbl.compile("cc", c_srcs, { order_only = G_kernel_prerequisites }),
	G_cfg:get("CONFIG_KERNEL_TESTS", "n")
)

return subdir_into
