local mbl = require("mbuildlib")
local mba = require("mbauxlib")
local OrderedMap = require("ordered_map")
local nyxbuild = require("build")
local sdirt = require("sdirtable")

local toolchain = OrderedMap.new({
	{ "cc", "${cross_compile}gcc" },
	{ "cpp", "${cross_compile}gcc -E" },
	{ "as", "${cross_compile}as" },
	{ "ar", "${cross_compile}ar" },
	{ "ld", "${cross_compile}ld" },
	{ "objcopy", "${cross_compile}objcopy" },
	{ "python", "python3" },
	{ "sh", "bash" },
})

local autoconf_h_path = mbl.bpath("include/autoconf.h")
local version_h_path = mbl.bpath("include/version.h")

local flags = OrderedMap.new({
	{
		"cflags",
		{
			"-nostartfiles",
			"-nodefaultlibs",
			"-nostdlib",
			"-nostdinc",
			"-ffreestanding",
			"-fshort-wchar",
			"-fno-omit-frame-pointer",
			"-fno-stack-protector",
			"-fno-builtin",
			"-fno-pic",
			"-fno-pie",
			"-std=gnu23",
			"-Wall",
			("-include %s"):format(mb.rel(autoconf_h_path)),
			("-include %s"):format(mb.rel(version_h_path)),
			mbl.incl(mb.file(".")),
			mbl.incl(mbl.bpath("include")),
		},
	},
	{
		"cppflags",
		{
			"-D__KERNEL__",
		},
	},
	{
		"asflags",
		{},
	},
	{
		"ascppflags",
		{
			"-D__ASSEMBLY__",
			mbl.incl(mb.file(".")),
			mbl.incl(mbl.bpath("include")),
		},
	},
	{
		"ldflags",
		{
			"-static",
			"-Bsymbolic",
			"-nostdlib",
			"-no-pie",
		},
	},
})

local extra_flags = require("extra_flags")

for k, v in pairs(extra_flags) do
	local config, var = k:match("^(.-)%$(.*)$")
	if G_cfg:get(config, "n") == "y" then
		flags[var] = mba.merge(flags[var], v or {})
	end
end

table.insert(flags.cflags, ("-O%s"):format(nyxbuild.cfg_string(G_cfg, "CONFIG_OPT", "2")))

G_kernel_prerequisites = mbl.files({
	version_h_path,
	autoconf_h_path,
})

local archinfo = mb.subdir(("arch/%s/info.lua"):format(Arch)) or {}

for k, v in pairs(archinfo.flags or {}) do
	local f = flags[k] or {}
	f = mba.merge(f, v)
	flags[k] = f
end

G_kernel_prerequisites = mba.merge(G_kernel_prerequisites, mba.flatten(archinfo.arch_order_only or {}))

mb.var("arch", Arch)
mb.var("cross_compile", Cross_compile)
mbl.write_vars(toolchain)
mbl.write_vars(flags)
mb.var("ldscript", mb.rel(archinfo.link))

--======================================
-- Rules
--======================================

mb.rule("cc", {
	command = "$cc $cflags $cppflags -MD -MF $out.d -c $in -o $out",
	deps = "gcc",
	depfile = "$out.d",
	description = "CC $in",
})

mb.rule("as", {
	command = "$cc -x assembler-with-cpp $asflags $ascppflags -MD -MF $out.d -c $in -o $out",
	deps = "gcc",
	depfile = "$out.d",
	description = "AS $in",
})

mb.rule("ld", {
	command = "$ld -T $ldscript $ldflags $in -o $out ",
	description = "LD $out",
})

mb.rule("objcopy_blob", {
	command = "$objcopy -I binary -O $bfdname "
		.. "--rename-section .data=.kernel_blob,alloc,load,readonly,data,contents $in $out",
	description = "OBJCOPY $out",
})

mb.rule("gen_ld_script", {
	command = ("$cpp -P -x assembler-with-cpp -include %s $in -o $out"):format(mb.rel(autoconf_h_path)),
	description = "CPP $out",
	restat = "1",
})

mb.rule("gen_autoconf", {
	command = ("ARCH=$arch srctree=%s KCONFIG_CONFIG=%s $python %s --header-path $out Kconfig"):format(
		mb.rel(".."),
		mb.rel("../.config"),
		mb.rel("../contrib/kconfiglib/genconfig.py")
	),
	description = "PY autoconf.h",
	restat = "1",
})

mb.rule("gen_version", {
	command = ("$sh %s $out.tmp && (cmp -s $out.tmp $out || cp $out.tmp $out)"):format(
		mb.rel("../tools/scripts/mkversion.sh")
	),
	description = "SH version.h",
	restat = "1",
})

--======================================
-- Edges
--======================================

local force = mbl.bpath("FORCE")

mb.build({
	rule = "phony",
	out = force,
})

mb.build({
	rule = "gen_autoconf",
	out = mbl.bpath("include/autoconf.h"),
	implicit = mb.file("../.config"),
})

mb.build({
	rule = "gen_version",
	out = mbl.bpath("include/version.h"),
	implicit = force,
})

local subdirs = {
	("arch/%s"):format(Arch),
	"dev",
	"fs",
	"init",
	"kern",
	"lib",
	"mm",
	"tests",
}

local collected = sdirt.collect(subdirs)

local kernel_vmbin = mb.build({
	rule = "ld",
	out = mbl.bpath("vmnyx"),
	inputs = collected.objs.y,
	implicit = archinfo.link,
})

local prekernel = mb.subdir("prekernel")

local kernel_blob = mb.build({
	rule = "objcopy_blob",
	out = mbl.bpath("prekernel/vmnyx.o"),
	inputs = kernel_vmbin,
	vars = { bfdname = prekernel.bfdname },
})

local image = mb.build({
	rule = "ld",
	out = mbl.bpath("image"),
	inputs = { prekernel.objs, kernel_blob },
	implicit = prekernel.link,
	vars = { ldscript = mb.rel(prekernel.link) },
})

-- cleanup globals
G_kernel_prerequisites = nil

return {
	vmnyx = kernel_vmbin,
	image = image,
}
