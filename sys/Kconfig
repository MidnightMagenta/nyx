rsource "arch/$(ARCH)/Kconfig"

rsource "prekernel/Kconfig"
rsource "mm/Kconfig"
rsource "kern/Kconfig"

menu "Kernel hacking"

config KERNEL_TESTS
    bool "Kernel unit tests"
    default n
    help
        Build the in-kernel unit tests in sys/tests and run them at boot.

config PRINTK_VERBOSITY
    int "Global printk verbosity"
    range 0 4
    default 2
    help
        Upper bound for all kernel messages. Per-subsystem log levels
        (under each subsystem's "Log levels" menu) are capped by this.

        0 = none
        1 = errors only
        2 = errors and warnings
        3 = errors, warnings, and info
        4 = errors, warnings, info, and verbose info

endmenu
